# PostgreSQL connection string for the app database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# Where `pytest` builds its scratch database. Optional, but strongly preferred
# on a developer machine where DATABASE_URL points at hosted Neon.
#
# pytest-django creates `test_<dbname>` on whatever server it is given. If that
# is the production project, the scratch database is created inside production
# and survives any interrupted run — which is how `test_land_v2` and
# `test_test_land_v2` came to be sitting in the live Neon project (found
# 2026-08-20, the second one ten months old).
#
# Set this once and a bare `pytest` simply works. backend/conftest.py refuses
# to run against a non-disposable server otherwise; the override is
# LANDSCAPE_ALLOW_TEST_DB=i-know-this-is-not-production, deliberately a phrase
# rather than a flag. See README → Testing → Backend (Django).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landscape

# Django secret key used for cryptographic signing
SECRET_KEY=change-me-to-a-long-random-string

# Debug mode for Django (use False in production)
DEBUG=False

# Comma-separated allowed hostnames (include Railway wildcard if needed)
ALLOWED_HOSTS=example.com,.railway.app

# Discord webhook URL for Landscaper chat feedback capture
# Messages containing #FB will be forwarded here with context for alpha testing
LANDSCAPER_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Shared secret for the morning-refresh scheduled-task skill.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty value blocks all requests to /api/feedback/dashboard-data/.
FEEDBACK_DASHBOARD_TOKEN=
