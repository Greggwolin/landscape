# PostgreSQL connection string for the app database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# Testing note. pytest-django creates `test_<dbname>` on whatever server
# DATABASE_URL names. If that is the production project, the scratch database is
# created INSIDE production and survives an interrupted run — which is how
# `test_land_v2` and `test_test_land_v2` came to be sitting in the live Neon
# project (found 2026-08-20, the second one ten months old).
#
# backend/conftest.py refuses to run against a non-disposable server. Point the
# run somewhere safe instead:
#
#     DATABASE_URL=postgresql://localhost/landscape pytest
#
# A TEST_DATABASE_URL variable exists but is honoured only when conftest is
# imported before Django settings are configured, which is NOT the case under
# pytest. Do not rely on it; use DATABASE_URL.

# Django secret key used for cryptographic signing
SECRET_KEY=change-me-to-a-long-random-string

# Debug mode for Django (use False in production)
DEBUG=False

# Comma-separated allowed hostnames (include Railway wildcard if needed)
ALLOWED_HOSTS=example.com,.railway.app

# Discord webhook URL for Landscaper chat feedback capture
# Messages containing #FB will be forwarded here with context for alpha testing
LANDSCAPER_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Shared secret for the morning-refresh scheduled-task skill.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty value blocks all requests to /api/feedback/dashboard-data/.
FEEDBACK_DASHBOARD_TOKEN=
